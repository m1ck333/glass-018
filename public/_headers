# Cloudflare Pages čita ovaj fajl. Redosled: prvo opšte, pa specifičnije.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Astro ubacuje heš u imena, pa se ovo može keširati zauvek.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fontovi se ne menjaju.
/_astro/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# Fotografije se menjaju retko — nedelja dana, uz proveru u pozadini.
/radovi/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/modeli/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/slike/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

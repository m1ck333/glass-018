---
interface Props {
  eyebrow: string;
  naslov: string;
  /** Reč(i) u naslovu koje se prikazuju mesinganim kurzivom. */
  akcenat?: string;
  opis?: string;
  /** Putanja do strane. Poslednja stavka je tekuća strana, bez linka. */
  mrvice?: { label: string; href?: string }[];
}

const { eyebrow, naslov, akcenat, opis, mrvice } = Astro.props;

/**
 * Google od ovoga pravi putanju u rezultatima pretrage umesto gole adrese.
 * Vredi na stranama modela, jer su one dolazne strane za oglase.
 */
const mrviceLd = mrvice && {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: mrvice.map((m, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: m.label,
    ...(m.href ? { item: new URL(m.href, Astro.site).href } : {}),
  })),
};
---

<header class="sz">
  <div class="wrap">
    {
      mrvice && (
        <nav class="mrvice" aria-label="Putanja">
          <ol>
            {mrvice.map((m, i) => (
              <li>
                {m.href ? <a href={m.href}>{m.label}</a> : <span aria-current="page">{m.label}</span>}
                {i < mrvice.length - 1 && <span class="mrvice__deli" aria-hidden="true">›</span>}
              </li>
            ))}
          </ol>
        </nav>
      )
    }
    {mrviceLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(mrviceLd)} />}
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="h1 sz__naslov">
      {naslov}{akcenat && <> <em>{akcenat}</em></>}
    </h1>
    {opis && <p class="lede sz__opis">{opis}</p>}
  </div>
</header>

<style>
  .sz {
    padding-block: clamp(3rem, 8vw, 6.5rem) clamp(2.5rem, 6vw, 4.5rem);
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(80% 100% at 85% 0%, var(--glow-page) 0%, transparent 60%),
      var(--ink-900);
  }

  .mrvice {
    margin-bottom: 1.5rem;
  }

  .mrvice ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--paper-faint);
  }

  .mrvice li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .mrvice a {
    text-decoration: none;
    transition: color 0.3s var(--ease);
  }

  .mrvice a:hover {
    color: var(--brass-bright);
  }

  .mrvice__deli {
    color: var(--line-strong);
  }

  .sz__naslov {
    margin-top: 1.5rem;
    max-width: 22ch;
    text-wrap: balance;
  }

  .sz__opis {
    margin-top: 1.75rem;
  }
</style>
